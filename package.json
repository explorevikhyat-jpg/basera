{
  "name": "basera-student-housing",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2018 --loader:.js=jsx --jsx=automatic --outfile=dist/bundle.js",
    "test": "node --test tests/*.test.mjs",
    "backend": "node backend/server.mjs",
    "backend:demo": "node backend/server.mjs --demo",
    "build:offline": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2018 --loader:.js=jsx --jsx=automatic --alias:lucide-react=./build/offline-icons.jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/bundle.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
